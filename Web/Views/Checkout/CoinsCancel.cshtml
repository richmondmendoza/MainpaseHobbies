@{
    ViewBag.Title = "Order Canceled";
    var user = Web.Controllers.BaseController.Identity;
}

<section style="text-align:center; padding:60px 20px; font-family:Arial, sans-serif;">
    @* Optional image *@
    @*
        <img src="https://via.placeholder.com/600x300"
             alt="Order canceled"
             style="max-width:100%; border-radius:12px; margin-bottom:30px;" />
    *@

    <h1 style="font-size:32px; margin-bottom:15px; color:#c0392b;">
        Order Canceled!
    </h1>

    <p style="font-size:18px; color:#555; max-width:600px; margin:0 auto 25px;">
        Your order has been canceled and no payment has been processed.
    </p>

    <p style="font-size:16px; color:#777; max-width:600px; margin:0 auto 30px;">
        If this was a mistake, you’re welcome to return to the store and try again.
        If you have any questions, feel free to contact our support team.
    </p>

    @if (user != null)
    {
        if ((user.Id > 0 & user.HasCustomerAccess))

        {
            <p style="font-size:16px; color:#777; max-width:600px; margin:0 auto 30px;">
                To retry hte payment, goto My Orders and select the order to continue the payment.
            </p>

            <a href="@Url.Action("Index", "MyOrders", new { area = "customer" })" class="btn btn-primary">
                Return to Orders
            </a>
        }
    }
    else
    {
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">
            Return to Home
        </a>
    }
</section>