
@using Repository.Extensions;

@model Dto.Dto.InventoryDetailsDto

@{
    ViewBag.Title = "Card Details";
}

<style>
    .badge {
        width: 80px;
    }

    .hidden {
        display: none !important;
    }
</style>

<div class="page-title" data-aos="fade">
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="@Url.Action("Index", "Home", new { area ="" })">Home</a></li>
                <li>Details</li>
                <li class="current">@Model.Name</li>
            </ol>
        </div>
    </nav>
</div>

<section id="service-details" class="service-details section">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-5" data-aos="fade-up" data-aos-delay="100">
                <div class="services-list">
                    <div class="tcg-image-container">
                        <img id="tcg-image-preview" src="@($"/Content/website_img/card_img/{Model.Id.ToString()}.png")" class="img-fluid" alt="">
                        @if (Model.FoilType.ToLower().Replace(" ", "") == "foil" ||
                             Model.FoilType.ToLower().Replace(" ", "") == "etchedfoil")
                        {
                            <div class="tcg-foil"></div>
                        }
                    </div>
                </div>

                @*<h4>@Model.PurchaseCurrency @Model.Price.ToString("n2")</h4>*@@*<p>Nam voluptatem quasi numquam quas fugiat ex temporibus quo est. Quia aut quam quod facere ut non occaecati ut aut. Nesciunt mollitia illum tempore corrupti sed eum reiciendis. Maxime modi rerum.</p>*@
            </div>

            <div class="col-lg-7" data-aos="fade-up" data-aos-delay="200">

                <img src="assets/img/services.jpg" alt="" class="img-fluid services-img">
                <h3>@Model.Name</h3>
                <p class="text-bold">[@Model.SetCode] - @Model.Collector</p>
                <p>@Model.CardType</p>

                @if (!string.IsNullOrEmpty(Model.ManaCost) |
                     !string.IsNullOrEmpty(Model.Rarity) |
                     !string.IsNullOrEmpty(Model.SetName) |
                     !string.IsNullOrEmpty(Model.IllustratedBy) |
                     !string.IsNullOrEmpty(Model.Color))
                {
                    <p>
                        @if (!string.IsNullOrEmpty(Model.ManaCost))
                        {
                            <span>
                                Mana Cost: @Html.Raw(Model.ManaCost.TransformToCardSymbols()) <br />
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Rarity))
                        {
                            <span>
                                Rarity: @Model.Rarity.ToUpper() <br />
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.SetName))
                        {
                            <span>
                                Set Name: @Model.SetName <br />
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.IllustratedBy))
                        {
                            <span>
                                Artist: @Model.IllustratedBy <br />
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Color))
                        {
                            <span>
                                Color: @Html.Raw(!string.IsNullOrEmpty(Model.Color) ? Model.Color.TransformToCardSymbols() : "Colorless")
                            </span>
                        }

                    </p>
                })

                <p>@Html.Raw(Model.Description.TransformToCardSymbols())</p>

                <p>
                    Condition: @Model.Condition.Replace("_", " ").ToUpper() <br />
                    Type: @Model.FoilType.ToUpper() <br />
                </p>

                <p class="h4">
                    Stock: @Model.InventoryCounts.Sum(a => a.Quantity).ToString("n0")
                </p>
                <p>
                    <h3>@Model.PurchaseCurrency.ToUpper() @Model.Price.ToString("n2")</h3>
                </p>
                <div class="row">
                    <div class="col-auto pr-0 ml-0">
                        <input type="number" min="1" max="@Model.Count" value="1" class="form-control text-sm" id="quantity" name="quantity" />
                    </div>
                    <div class="col-5 pl-0 ml-0">
                        <btn id="btn-add-to-cart" class="btn btn-primary">Add to cart</btn>
                    </div>
                </div>
            </div>

        </div>

    </div>

</section>

@section scripts{
    <script>

        function rotate(id) {
            angle += 45;
            $(id).css({ 'transform': 'rotate(' + angle + 'deg)' });
        }

        $(document).ready(function () {

            $('#btn-add-to-cart').on('click', function (e) {
                AddToCart({
                    limit: @((int)Model.Count),
                    value: $('#quantity').val(),
                    cardId: "@Infrastructure.Fletcher.Encrypt(Model.Id.ToString())",
                });
            });

            $(document).on('click', '#btn-rotate', function () {

                if ($("#image-back").hasClass("hidden")) {
                    $("#image-front").addClass("hidden");
                    $("#image-back").removeClass("hidden");
                } else {
                    $("#image-front").removeClass("hidden");
                    $("#image-back").addClass("hidden");
                }

            });


        });

    </script>

}