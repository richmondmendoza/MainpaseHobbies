@using Repository.Extensions;
@using Infrastructure;

@{
    ViewBag.Title = "Home";

    var inventories = ViewBag.Inventories as List<Dto.Dto.InventoryDisplayDto>;
    var events = ViewBag.Events as List<Dto.Dto.EventDto>;
    var banners = ViewBag.Banners as List<Dto.BaseSettings.BannerDto>;
}

<link href="~/Content/assets/css/Custom.css" rel="stylesheet" />
<style>
    .hero .carousel-item::before {
        background-color: transparent;
    }
</style>

<!-- Hero Section -->
@if (banners.Any())
{
    int carIndex = 0;
    <section id="hero" class="hero section dark-background">

        <div id="hero-carousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">

            @foreach (var item in banners)
            {
                carIndex++;
                <div class="carousel-item @(carIndex == 1 ? "active" : "")">
                    <img src="data:image/@item.Image.GetImageExtension().Replace(".", "");base64,@item.ImageBase64" alt="">
                </div>
            }

            <a class="carousel-control-prev" href="#hero-carousel" role="button" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bi bi-chevron-left" aria-hidden="true"></span>
            </a>

            <a class="carousel-control-next" href="#hero-carousel" role="button" data-bs-slide="next">
                <span class="carousel-control-next-icon bi bi-chevron-right" aria-hidden="true"></span>
            </a>

            <ol class="carousel-indicators"></ol>

        </div>

    </section>
}

<section id="team" class="team section">

    <!-- Section Title -->
    <div class="container section-title mb-3 pb-0" data-aos="fade-up">
        <h2 class="mb-0" style="text-align: left; border-left: 10px solid var(--accent-color); padding-left: 10px; ">Collections</h2>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-5">

            @if (inventories != null && inventories.Count > 0)
            {
                foreach (var item in inventories)
                {

                    <div class="col-xl-3 col-md-4 d-flex" data-aos="zoom-in" data-aos-delay="100">
                        <a href="@Url.Action("CardDetails", "Home", new {area = "", cardId = item.EncId})">
                            <div class="team-member">
                                <div class="member-img tcg-image-container">
                                    <img id="tcg-image-preview" src="data:image/@item.MimeType;base64,@item.ImageBase64" class="img-fluid" alt="">
                                    @if (item.FoilType.ToLower().Replace(" ", "") == "foil" ||
                                         item.FoilType.ToLower().Replace(" ", "") == "etchedfoil")
                                    {
                                        <div class="tcg-foil"></div>
                                    }
                                </div>
                                <div class="member-info">
                                    @*<h4>@item.Name</h4>*@
                                    <span>
                                        @item.Currency @item.Price.ToString("n2")
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }

            <div class="col-xl-3 col-md-4 d-flex" id="viewAllCard">
                <div class="team-member w-100 d-flex align-items-center justify-content-center">
                    <a href="@Url.Action("Search", "Home", new {area = ""})" class="">
                        <i class="fa-regular fa-circle-right" style="font-size: 18px;"></i> View All Cards
                    </a>
                </div>
            </div>

        </div>

    </div>

</section>


<section class="about section">

    <div class="container section-title mb-3 pb-0" data-aos="fade-up">
        <h2 class="mb-0" style="text-align: left; border-left: 10px solid var(--accent-color); padding-left: 10px; ">Upcoming Events</h2>
    </div>

    <div class="container">

        @if (events != null && events.Count > 0)
        {
            int index = 0;
            foreach (var item in events.OrderByDescending(a => a.DateOfEvent))
            {
                if (index % 2 == 0)
                {
                    <div class="row gy-4">
                        <div class="col-lg-6">
                            <img src="data:image/@item.MimeType;base64,@item.FeaturedImageBase64" class="img-fluid rounded-4 mb-4" alt="">
                        </div>
                        <div class="col-lg-6 d-flex align-items-center">
                            <div class="content ps-0 ps-lg-5">
                                <h4>@item.Title</h4>

                                @Html.Raw(item.SubTitle)

                                @if (!string.IsNullOrEmpty(item.Body))
                                {
                                    <div class="position-relative mt-4">
                                        <a href="@Url.Action("EventDetail", "Home", new { area = "", id=item.Id })" class="">Read More..</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row gy-4">
                        <div class="col-lg-6 d-flex align-items-center">
                            <div class="content ps-0 ps-lg-5">
                                <h4>@item.Title</h4>

                                @Html.Raw(item.SubTitle)

                                @if (!string.IsNullOrEmpty(item.Body))
                                {
                                    <div class="position-relative mt-4">
                                        <a href="@Url.Action("EventDetail", "Home", new { area = "", id=item.Id })" class="">Read More..</a>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6 aos-init aos-animate" data-aos="fade-up" data-aos-delay="100">
                            <img src="data:image/@item.MimeType;base64,@item.FeaturedImageBase64" class="img-fluid rounded-4 mb-4" alt="">
                        </div>
                    </div>
                }

                index++;
            }
        }

    </div>

</section>

@section scripts{

    <script>

        $(document).ready(function () {




        });

    </script>

}