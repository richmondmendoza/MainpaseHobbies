@{
    ViewBag.Title = "Returning to Store";
    var user = Web.Controllers.BaseController.Identity;

    var checkoutId = ViewBag.CheckoutId as string ?? Request["checkoutId"];
    var requestId = ViewBag.RequestId as string ?? Request["requestId"];
    var latestStatus = ViewBag.LatestStatus as string; // If you load from DB
}
<section class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="badge bg-secondary px-3 py-2 fs-6">Returning</span>
                    </div>

                    <h1 class="h3 mb-2">We’re finalizing your payment…</h1>
                    <p class="text-muted mb-4">
                        Please wait a moment while we confirm the result. You may refresh this page or check your order list.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(checkoutId) || !string.IsNullOrWhiteSpace(requestId) || !string.IsNullOrWhiteSpace(latestStatus))
                    {
                        <div class="alert alert-info text-start">
                            @if (!string.IsNullOrWhiteSpace(checkoutId))
                            {<div><strong>Checkout ID:</strong> @checkoutId</div>}
                            @if (!string.IsNullOrWhiteSpace(requestId))
                            {<div><strong>Request ID:</strong> @requestId</div>}
                            @if (!string.IsNullOrWhiteSpace(latestStatus))
                            {<div><strong>Latest Status:</strong> @latestStatus</div>}
                        </div>
                    }

                    @if (user != null && (user.Id > 0 & user.HasCustomerAccess))
                    {
                        <a href="@Url.Action("Index", "MyOrders", new { area = "customer" })" class="btn btn-primary me-2">
                            Go to My Orders
                        </a>
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-secondary">
                            Return to Home
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">
                            Return to Home
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>