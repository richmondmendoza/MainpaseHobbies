
@model IEnumerable<Dto.Dto.EventDto>

@{
    ViewBag.Title = "Upcoming Events";
}


<div class="page-title" data-aos="fade">
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="@Url.Action("Index", "Home", new { area ="" })">Home</a></li>
                <li class="current">Upcoming Events</li>
            </ol>
        </div>
    </nav>
</div>

<section class="about section">

    <div class="container section-title aos-init aos-animate" data-aos="fade-up">
        <h2>Mainphase Hobbies Events</h2>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        @if (Model.Any())
        {
            int index = 0;
            foreach (var item in Model.OrderByDescending(a => a.DateOfEvent))
            {
                var imagePath = Url.Content($"~/Content/website_img/event_img/{item.Id.ToString()}.png");

                if (index % 2 == 0)
                {
                    <div class="row gy-4">
                        <div class="col-lg-6">
                            <img src="@imagePath" class="img-fluid rounded-4 mb-4" alt="">
                        </div>
                        <div class="col-lg-6 d-flex align-items-center">
                            <div class="content ps-0 ps-lg-5">
                                <h4>@item.Title</h4>

                                @Html.Raw(item.SubTitle)

                                @if (!string.IsNullOrEmpty(item.Body))
                                {
                                    <div class="position-relative mt-4">
                                        <a href="@Url.Action("EventDetail", "Home", new { area = "", id=item.Id })" class="">Read More..</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row gy-4">
                        <div class="col-lg-6 d-flex align-items-center">
                            <div class="content ps-0 ps-lg-5">
                                <h4>@item.Title</h4>

                                @Html.Raw(item.SubTitle)

                                @if (!string.IsNullOrEmpty(item.Body))
                                {
                                    <div class="position-relative mt-4">
                                        <a href="@Url.Action("EventDetail", "Home", new { area = "", id=item.Id })" class="">Read More..</a>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6 aos-init aos-animate" data-aos="fade-up" data-aos-delay="100">
                            <img src="data:image/@item.MimeType;base64,@item.FeaturedImageBase64" class="img-fluid rounded-4 mb-4" alt="">
                        </div>
                    </div>
                }

                index++;
            }
        }
    </div>

</section>