
@{
    ViewBag.Title = "Privacy Policy";
    var info = Web.Controllers.BaseController.SystemInfo;
}



<div class="page-title" data-aos="fade">
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="@Url.Action("Index", "Home", new { area ="" })">Home</a></li>
                <li class="current">Privacy Policy</li>
            </ol>
        </div>
    </nav>
</div>

<section id="contact" class="contact section">

    <div class="container section-title aos-init aos-animate" data-aos="fade-up">
        <h2>Privacy Policy</h2>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">
            <div class="col-12 mb-3">
                <p class="text-bold">Last updated: January 1, 2026</p>

                <p>
                    This Privacy Policy explains how <strong>@info.LongName</strong>
                    ("we", "our", or "us") collects, uses, and protects your personal information when
                    you use our website, create an account, or place an order.
                </p>

                <h4 class="mb-3">1. Information We Collect</h4>

                <h5>a. Personal Information</h5>
                <ul>
                    <li>Customer Name</li>
                    <li>Mobile Number</li>
                    <li>Email Address</li>
                    <li>Billing Address (Floor, Block, Lot, Street)</li>
                    <li>Address (Barangay, City, Province, Postal Code)</li>
                </ul>

                <h5>b. Account Information</h5>
                <ul>
                    <li>Login credentials (username and encrypted password)</li>
                    <li>Order history and account activity</li>
                </ul>

                <h5>c. Order Information</h5>
                <ul class="mb-3">
                    <li>Order Notes</li>
                    <li>Payment Method (Pay in Store, Card Payment)</li>
                    <li>Shipping Method (Pickup at Store, Book Your Own Rider, Ship via LBC)</li>
                </ul>

                <h4 class="mb-3">2. How We Use Your Information</h4>
                <ul class="mb-3">
                    <li>To process and fulfill orders</li>
                    <li>To manage customer accounts and logins</li>
                    <li>To send order confirmations and updates</li>
                    <li>To provide customer support</li>
                    <li>To improve our website and services</li>
                    <li>To comply with legal requirements</li>
                </ul>

                <h4 class="mb-3">3. Payment Information</h4>
                <p class="mb-3">
                    We do not store full card payment details. Card payments are processed securely
                    through third-party payment providers, and we only receive confirmation of payment.
                </p>

                <h4 class="mb-3">4. Sharing of Information</h4>
                <p>We may share your information with:</p>
                <ul>
                    <li>Delivery partners (e.g., LBC or assigned riders)</li>
                    <li>Payment processors</li>
                    <li>Legal authorities when required by law</li>
                </ul>
                <p class="mb-3">We do not sell or rent your personal information.</p>

                <h4 class="mb-3">5. Data Security</h4>
                <p class="mb-3">
                    We use reasonable security measures such as secure authentication and restricted
                    access to protect your data. However, no online system is completely secure.
                </p>

                <h4 class="mb-3">6. Account Responsibility</h4>
                <p class="mb-3">
                    You are responsible for maintaining the confidentiality of your account credentials
                    and all activities under your account.
                </p>

                <h4 class="mb-3">7. Data Retention</h4>
                <p class="mb-3">
                    We retain personal information only as long as necessary for business and legal
                    purposes.
                </p>

                <h4 class="mb-3">8. Your Rights</h4>
                <p class="mb-3">
                    You may request access, correction, or deletion of your personal information by
                    contacting us.
                </p>

                <h4 class="mb-3">9. Changes to This Policy</h4>
                <p class="mb-3">
                    We may update this Privacy Policy at any time. Changes will be posted on this page.
                </p>

                <h4 class="mb-3">10. Contact Information</h4>
                <p class="mb-3">
                    Email: @info.Email<br>
                    Phone: @info.ContactNumber1
                </p>
            </div>
        </div>

    </div>

</section>