
@model Dto.Dto.OrderDetailsDto

@{
    ViewBag.Title = $"Order #{Model.OrderNumber}";
    var sysInfo = Web.Controllers.BaseController.SystemInfo;
}

<style>
    .content-header {
        display: none;
    }

    #refund-modal {
        z-index: 1061;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="invoice p-3 mb-3" id="print-data">
            <div class="row">
                <div class="col-12">
                    <h4>
                        <img src="~/Content/website_img/logo.jpg" style="height: 50px;" /> @sysInfo.LongName
                        <small class="float-right">Date: @Model.DateCreated.ToString("MMM d, yyyy")</small>
                    </h4>
                </div>
            </div>

            <div class="row invoice-info">
                <div class="col-sm-4 invoice-col">
                    From
                    <address>
                        <strong>@sysInfo.LongName</strong><br>
                        @sysInfo.Address1<br>
                        @sysInfo.Address2<br>
                        Phone: @sysInfo.ContactNumber1<br>
                        Email: @sysInfo.ContactEmail1
                    </address>
                </div>

                <div class="col-sm-4 invoice-col">
                    To
                    <address>
                        <strong>@Model.CustomerName</strong><br>
                        @Model.Address1<br>
                        @Model.Address2<br>
                        Phone: @Model.ContactNumber<br>
                        Email: @Model.ContactEmail
                    </address>
                </div>

                <div class="col-sm-4 invoice-col">
                    <b>Invoice #@Model.InvoiceNumber</b><br>
                    <br>
                    <b>Order ID:</b> @Model.OrderNumber<br>
                    <b>Payment Due:</b> 2/22/2014<br>
                    <b>Account:</b> 968-34567
                </div>
            </div>

            <div class="row">
                <div class="col-12 table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Qty</th>
                                <th>Product</th>
                                <th>Description</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Quantity.ToString("n0")</td>
                                        <td>@item.ProductName</td>
                                        <td>@item.PreviousOwnerName</td>
                                        <td class="text-right">@Model.Currency @item.Total.ToString("n2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row">

                <div class="col-6 row">
                    <div class="col-sm-6">
                        <p class="lead">Payment Methods:</p>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.PaymentMethod == Dto.Enums.PaymentMethodEnum.Cash ? "checked" : "") />
                            <label>Store Payment</label>
                        </div>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.PaymentMethod == Dto.Enums.PaymentMethodEnum.PayPal ? "checked" : "") />
                            <label>PayPal</label>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <p class="lead">Delivery Methods:</p>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.DeliveryMethod == Dto.Enums.DeliveryMethodEnum.StorePickup ? "checked" : "") />
                            <label>Store Pickup</label>
                        </div>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.DeliveryMethod == Dto.Enums.DeliveryMethodEnum.LBC ? "checked" : "") />
                            <label>Ship via LBC</label>
                        </div>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.DeliveryMethod == Dto.Enums.DeliveryMethodEnum.BookYourOwn ? "checked" : "") />
                            <label>Book your own Rider</label>
                        </div>
                    </div>

                    <div class="col-sm-12">
                        <h5>Thanks for your order!</h5>
                        <p>We’ve received it and are getting everything ready for you. Stay tuned for updates!</p>
                    </div>

                </div>

                <div class="col-6">
                    <p class="lead">&nbsp;</p>
                    <div class="table-responsive">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <th style="width:50%">Subtotal:</th>
                                    <td class="text-right">@Model.Currency @Model.SubTotal.ToString("n2")</td>
                                </tr>
                                <tr>
                                    <th>Tax (0%)</th>
                                    <td class="text-right">@Model.Currency @Model.Tax.ToString("n2")</td>
                                </tr>
                                <tr>
                                    <th>Shipping:</th>
                                    <td class="text-right">@Model.Currency @Model.Shipping.ToString("n2")</td>
                                </tr>
                                <tr>
                                    <th class="text-red">Refunded:</th>
                                    <td class="text-right text-red">@((ViewBag.RefundedAmount ?? 0).ToString("f2"))</td>
                                </tr>
                                <tr>
                                    <th>Total:</th>
                                    <td class="text-right">@Model.Currency @((Model.Total - (ViewBag.RefundedAmount ?? 0)).ToString("f2"))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="row no-print">
                <div class="col-12">
                    <a href="javascript:;" class="btn btn-default print" print-data="#print-data"><i class="fas fa-print"></i> Print</a>

                    @switch (Model.Status)
                    {
                        case Dto.Enums.OrderStatusEnum.Processing:
                        case Dto.Enums.OrderStatusEnum.Completed:
                            if (Model.Status != Dto.Enums.OrderStatusEnum.Cancelled & Model.Status != Dto.Enums.OrderStatusEnum.Refunded)
                            {
                                <a href="javascript:;" id="btn-refund" class="btn btn-primary ml-2">Refund</a>
                            }
                            break;
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="refund-modal">
    <div class="modal-dialog">
        @using (Html.BeginForm("Refund", "Dashboard", FormMethod.Post, new { area = "portal", id = "form-refund" }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Refund Amount</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="form-group row">
                        <label class="col-sm-5 col-form-label text-right">Enter Amount</label>
                        <div class="col-sm-7">
                            <input type="text" class="form-control forceNumeric" name="amount" id="amount" required />
                            @Html.ValidationMessage("amount")
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="javascript:;" type="button" class="btn btn-default btn-sm pull-right" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</a>
                    <button type="submit" class="btn btn-primary btn-sm pull-right ml-2"><i class="fa fa-save"></i> Save Refund</button>
                </div>
            </div>
        }
    </div>
</div>


@section scripts{
    <script>
        $(document).ready(function () {

            $('#btn-refund').on('click', function () {
                $('#amount').val('');
                $('#refund-modal').modal({ 'backdrop': 'static' }).modal('show');
            });

        })
    </script>
}