
@model IEnumerable<Dto.Dto.InventoryDetailsDto>

<table id="data-table" class="table table-sm table-bordered w-100">
    <thead>
        <tr>
            <th>&nbsp;</th>
            <th>Name</th>
            <th>Card #</th>
            <th>Set Code</th>
            <th>Set Name</th>
            <th>Foil Type</th>
            <th>Currency</th>
            <th>Price</th>
            <th>Available</th>
            <th>Owner</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="icheck-primary">
                        <input type="checkbox" id="chk-@item.Id" class="chk-select-id" link-id="@item.Id">
                        <label for="chk-@item.Id"></label>
                    </div>
                </td>
                <td>@item.Name</td>
                <td>@item.Collector</td>
                <td>@item.SetCode</td>
                <td>@item.SetName</td>
                <td>@item.FoilType</td>
                <td>@item.PurchaseCurrency</td>
                <td>
                    <input type="text" class="txt-price text-right d-none" id="txt-price-@item.Id" link-id="@item.Id" value="@item.PriceDisplay">
                    <span class="not-price">@item.PriceDisplay</span>
                </td>
                <td>@item.Count</td>
                <td>@item.OwnerName</td>
            </tr>
        }
    </tbody>
</table>
