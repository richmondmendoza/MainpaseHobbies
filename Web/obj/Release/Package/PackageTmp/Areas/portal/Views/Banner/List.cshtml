@using Repository.Extensions;

@model IEnumerable<Dto.BaseSettings.BannerDto>
@{
    ViewBag.Title = "Banners";
}


<style>
    .dataTables_wrapper {
        width: 100%;
    }

    #add-banner-modal {
        z-index: 1061;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header pt-4 pb-4">
                <h3 class="card-title">
                    Banners
                </h3>
                <div class="card-tools">
                    <ul class="nav nav-pills ml-auto">
                        <li class="nav-item">
                            <a class="nav-link active" id="btn-add-banner" href="javascript:;"><i class="fa fa-plus"></i> Add Banner</a>
                        </li>
                        @*<li class="nav-item">
                                <a class="nav-link" href="#sales-chart" data-toggle="tab">Donut</a>
                            </li>*@
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <table id="data-table" class="table table-sm table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img id="tcg-image-preview" class="tcg-image" style="height: 250px !important;" src="data:image/@item.Image.GetImageExtension().Replace(".", "");base64,@item.ImageBase64" alt="Image preview" />
                                    </td>
                                    <td style="text-align: center;">
                                        <a href="javascript:;" class="btn btn-sm btn-danger btn-delete" link="@item.Id" title="Delete this Banner"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div><!-- /.card-body -->
        </div>
    </div>
</div>

<div class="modal" id="add-banner-modal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            @using (Html.BeginForm("Add", "Banner", FormMethod.Post, new { area = "portal", enctype = "multipart/form-data" }))
            {
                <div class="modal-header">
                    <h4 class="modal-title">Add New Banner</h4>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="ImageFile">Upload image</label><br>
                        <input type="file" id="ImageFile" name="ImageFile" accept="image/*" onchange="previewImage(event)" />
                    </div>
                    <div>
                        <div class="tcg-image-container">
                            <img id="tcg-image-preview" class="tcg-image w-100" src="" alt="Image preview" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="javascript:;" type="button" class="btn btn-default btn-flat  btn-sm pull-right" data-dismiss="modal"><i class="fa fa-times"></i>   Close</a>
                    <button type="submit" class="btn btn-sm btn-primary ml-2 pull-right"><i class="fa fa-save"></i> Save this banner</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts{
    <script>

        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById("tcg-image-preview");

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = "block";
                };

                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = "";
            }
        }

        $(document).ready(function () {
            var dataTable = $('#data-table').DataTable({
                "processing": true,
                //"serverSide": true,
                "stateSave": true,
                "searching": false,
                //"bLengthChange": false,
                "responsive": false,
                "autoWidth": true,
                "paging": true,
                buttons: [],
                "lengthMenu": [[10, 20, 50, -1], [10, 20, 50, 'All']]
            });

            $('.btn-delete').on('click', function () {
                var id = $(this).attr('link');

                $('#confirm-modal').modalConfirm({
                    url: '@Url.Action("Delete", "Banner", new { area = "portal" })',
                    header: 'Cancel Order',
                    message: 'Do you want to delete this banner',
                    param1: id
                });
            });

            $('#btn-add-banner').on('click', function (e) {
                $('#add-banner-modal').modal({ 'backdrop': 'static' }).modal('show');
            });

        });
    </script>
}