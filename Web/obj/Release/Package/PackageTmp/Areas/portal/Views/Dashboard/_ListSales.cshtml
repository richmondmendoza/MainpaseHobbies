
@model IEnumerable<Dto.Dto.SalesDisplayDto>

<table class="table table-striped table-bordered" id="data-table">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Payment Date</th>
            <th>Currency</th>
            <th>Total</th>
            <th>Remarks</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model.OrderByDescending(a => a.PaymentDate))
            {
                <tr class="@(item.IsRefund ? "text-red" : "")">
                    <td>@item.OrderNumber</td>
                    <td>
                        <span class="d-none">@item.PaymentDate.ToString("yyyyMMddHHmmss")</span>
                        @item.PaymentDate.ToString("dd MMM, yyyy hh:mm tt")
                    </td>
                    <td>@item.Currency</td>
                    <td>@item.Amount.ToString("F2")</td>
                    <td>@(item.IsRefund ? item.Remarks : "")</td>
                    <td style="text-align: center;">
                        <a href="@Url.Action("Details", "Dashboard", new { area = "portal", id = item.OrderId })" target="_blank" class="btn btn-sm btn-primary" title="View Details"><i class="fa fa-eye"></i></a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
