
@model IEnumerable<Dto.Dto.EventDto>

@{
    ViewBag.Title = "Events";
}

<style>
    .dataTables_wrapper {
        width: 100%;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header pt-4 pb-4">
                <h3 class="card-title">
                    Items
                </h3>
                <div class="card-tools">
                    <ul class="nav nav-pills ml-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="@Url.Action("Add", "Events", new {area = "portal"})">
                                <i class="fa fa-plus"></i> Add New
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <table id="data-table" class="table table-sm table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Date of Event</th>
                            <th>Title</th>
                            <th>Sub Title</th>
                            <th>Body</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DateOfEvent.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td>@item.Title</td>
                                    <td>@(Html.Raw(item.SubTitle))</td>
                                    <td>@(Html.Raw(item.Body))</td>
                                    <td style="text-align: center;">
                                        <a href="@Url.Action("Update", "Events", new {area = "portal", id = item.Id})" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div><!-- /.card-body -->
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            var accountTable = $('#data-table').DataTable({
                "processing": true,
                //"serverSide": true,
                "stateSave": true,
                "searching": true,
                //"bLengthChange": false,
                "responsive": true,
                "autoWidth": true,
                "paging": true,
                buttons: [],
                "lengthMenu": [[10, 20, 50, -1], [10, 20, 50, 'All']]
            });

        });
    </script>
}