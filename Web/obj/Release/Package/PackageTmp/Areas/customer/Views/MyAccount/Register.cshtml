
@model Web.Models.UserViewModel

@{
    Layout = "~/Areas/customer/Views/Shared/_Layout_Login.cshtml";
    ViewBag.Title = "Register My Account";
}


<div class="login-box">
    <!-- /.login-logo -->
    <div class="card card-outline card-primary">

        <div class="card-header text-center">
            <a href="@Url.Action("index", "home", new {area = ""})" class="h1">Mainphase</a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">Create your own Mainphase account now!</p>

            @using (Html.BeginForm("Register", "MyAccount", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Role)

                <div class="form-group mb-3">
                    @Html.TextBoxFor(a => a.Firstname, new { @class = "form-control", placeholder = "First Name", autocomplete = false })
                    @Html.ValidationMessageFor(a => a.Firstname)
                </div>
                <div class="form-group mb-3">
                    @Html.TextBoxFor(a => a.LastName, new { @class = "form-control", placeholder = "Last Name", autocomplete = false })
                    @Html.ValidationMessageFor(a => a.LastName)
                </div>
                <div class="form-group mb-3">
                    @Html.TextBoxFor(a => a.Username, new { @class = "form-control", placeholder = "Username", autocomplete = false })
                    @Html.ValidationMessageFor(a => a.Username)
                </div>
                <div class="form-group mb-3">
                    @Html.PasswordFor(a => a.Password, new { @class = "form-control", placeholder = "Password", autocomplete = false })
                    @Html.ValidationMessageFor(a => a.Password)
                </div>
                <div class="form-group mb-3">
                    @Html.PasswordFor(a => a.ConfirmPassword, new { @class = "form-control", placeholder = "Re-enter your password", autocomplete = false })
                    @Html.ValidationMessageFor(a => a.ConfirmPassword)
                </div>

                <div class="row">
                    <div class="col-8">
                        <div class="icheck-primary">
                            <input type="checkbox" id="iAgree" required />
                            <label for="iAgree">
                                I agree to the <a href="#" target="_blank">terms</a>
                            </label>
                        </div>
                    </div>
                    <!-- /.col -->
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">Register</button>
                    </div>
                    <!-- /.col -->
                </div>
            }
            <div class="social-auth-links text-center">
                <p>- OR -</p>
                <a href="@Url.Action("Login", "MyAccount", new {area = "customer"})" class="">Login you account</a>
            </div>


        </div>
        <!-- /.card-body -->

    </div>
    <!-- /.card -->
</div>