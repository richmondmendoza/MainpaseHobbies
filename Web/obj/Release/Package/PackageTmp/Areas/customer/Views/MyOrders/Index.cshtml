
@model IEnumerable<Dto.Dto.OrderDto>
@{
    ViewBag.Title = "My Orders";
}

<style>
    .dataTables_wrapper {
        width: 100%;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header pt-4 pb-4">
                <h3 class="card-title">
                    My Orders
                </h3>
            </div>
            <div class="card-body">
                <table id="data-table" class="table table-sm table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model.OrderByDescending(a => a.Id))
                            {
                                <tr>
                                    <td>@item.OrderNumber</td>
                                    <td>@item.DateCreated.ToString("MMM-dd-yyyy")</td>
                                    <td>@(!item.IsPaid & (item.Status != Dto.Enums.OrderStatusEnum.Cancelled & item.Status != Dto.Enums.OrderStatusEnum.Refunded) ?  "Waiting for payment" : item.Status.ToString() )</td>
                                    <td class="text-right">@item.Currency @item.Total.ToString("n2")</td>
                                    <td style="text-align: center;">
                                        <a href="@Url.Action("Details", "MyOrders", new {area = "customer", id = item.Id})" class="btn btn-sm btn-secondary ml-2"><i class="fa fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div><!-- /.card-body -->
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            var accountTable = $('#data-table').DataTable({
                "processing": true,
                //"serverSide": true,
                "stateSave": true,
                "searching": true,
                //"bLengthChange": false,
                "responsive": true,
                "autoWidth": false,
                "paging": true,
                buttons: [],
                "lengthMenu": [[10, 20, 50, -1], [10, 20, 50, 'All']]
            });

        });
    </script>
}