@using Web.Utils

@{
    var user = Web.Controllers.BaseController.Identity;
}


<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="@Url.Action("index", "home", new {area = ""})" class="brand-link">
        <img src="~/Content/website_img/logo.jpg" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
        <span class="brand-text font-weight-light">Mainphase Hobbies</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                <li class="nav-item">
                    <a href="@Url.Action("Index", "Dashboard", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Dashboard", "Index", "active")">
                        <i class="nav-icon fas fa-home"></i><p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <i class="nav-icon fas fa-warehouse"></i>
                        <p>Invetory <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="@Url.Action("List", "Inventory", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Inventory", "List|Add|Update|Details", "active")">
                                <i class="far fa-circle nav-icon"></i><p>List</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Upload", "Inventory", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Inventory", "Upload", "active")">
                                <i class="far fa-circle nav-icon"></i><p>Upload</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Bulk", "Inventory", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Inventory", "Bulk", "active")">
                                <i class="far fa-circle nav-icon"></i><p>Bulk Action</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item @Html.RouteIf("portal", "OrderManagement", "Details", "menu-open")">
                    <a href="#" class="nav-link">
                        <i class="nav-icon fas fa-cart-shopping"></i>
                        <p>Orders <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="@Url.Action("List_Pending", "OrderManagement", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "OrderManagement", "List_Pending", "active")">
                                <i class="far fa-circle nav-icon text-warning"></i><p>Pending</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("List_Completed", "OrderManagement", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "OrderManagement", "List_Completed", "active")">
                                <i class="far fa-circle nav-icon text-success"></i><p>Completed</p>
                            </a>
                        </li>
                    </ul>
                </li>

                @if (user.HasProtalAdminAccess)
                {
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Events", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Events", "Index|Add|Update", "active")">
                            <i class="nav-icon fas fa-calendar"></i><p>Events</p>
                        </a>
                    </li>
                }

                <li class="nav-header">SETTINGS</li>

                @if (user.HasProtalAdminAccess)
                {
                    <li class="nav-item">
                        <a href="@Url.Action("List", "Banner", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Banner", "List", "active")">
                            <i class="nav-icon fas fa-image"></i>
                            <p>Website Home Banners</p>
                        </a>
                    </li>
                }

                @if (user.HasProtalAdminAccess)
                {
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Conversion", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Conversion", "Index", "active")">
                            <i class="nav-icon fas fa-circle-dollar-to-slot"></i>
                            <p>Conversion</p>
                        </a>
                    </li>
                }

                <li class="nav-item">
                    <a href="@Url.Action("List", "Account", new {area = "portal"})" class="nav-link @Html.RouteIf("portal", "Account", "List|Add|Details", "active")">
                        <i class="nav-icon fas fa-users-cog"></i>
                        <p>Users</p>
                    </a>
                </li>


            </ul>
        </nav>
        <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
</aside>