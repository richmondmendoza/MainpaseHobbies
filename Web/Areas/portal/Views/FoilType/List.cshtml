@model IEnumerable<Dto.BaseSettings.NameDto>
@{
    ViewBag.Title = "Categories";
}


<style>
    .dataTables_wrapper {
        width: 100%;
    }

    #add-modal {
        z-index: 1061;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header pt-4 pb-4">
                <h3 class="card-title">
                    Categories
                </h3>
                <div class="card-tools">
                    <ul class="nav nav-pills ml-auto">
                        <li class="nav-item">
                            <button type="button" class="btn btn-primary btn-sm" id="btn-add"><i class="fa fa-plus"></i> Add Category</button>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <table id="data-table" class="table table-sm table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model.OrderBy(a => a.Id))
                            {
                                <tr>
                                    <td>@item.Name</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div><!-- /.card-body -->
        </div>
    </div>
</div>

<div class="modal" id="add-modal">
    <div class="modal-dialog modal-lg">
        @using (Html.BeginForm("Add", "FoilType", FormMethod.Post, new { area = "portal", id = "form-add" }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Message</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group row">
                        <label class="col-lg-3 col-md-5 col-sm-12 col-form-label">Type Name</label>
                        <div class="col-lg-9 col-md-7 col-sm-12">
                            <input type="text" class="form-control" name="name" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="javascript:;" type="button" class="btn btn-default btn-sm pull-right" data-dismiss="modal"><i class="fa fa-times"></i>   Close</a>
                    <button type="submit" class="btn btn-primary btn-sm pull-right"><i class="fa fa-save"></i>   Save</button>
                </div>
            </div>
        }
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            var accountTable = $('#data-table').DataTable({
                "processing": true,
                //"serverSide": true,
                "stateSave": true,
                "searching": true,
                //"bLengthChange": false,
                "responsive": true,
                "autoWidth": true,
                "paging": true,
                buttons: [],
                "lengthMenu": [[10, 20, 50, -1], [10, 20, 50, 'All']]
            });

            $('#btn-add').on('click', function (e) {
                $('#add-modal').modal({ 'backdrop': 'static' }).modal('show');
            });


        });
    </script>
}