
@model Dto.Dto.OrderDetailsDto

@{
    ViewBag.Title = $"Order #{Model.OrderNumber}";
    var sysInfo = Web.Controllers.BaseController.SystemInfo;
}

<style>
    .content-header {
        display: none;
    }
</style>

<div class="row">
    <div class="col-12">

        <div class="callout callout-info mt-3">
            @switch (Model.Status)
            {
                case Dto.Enums.OrderStatusEnum.Pending:

                    <h5>Status: Pending Order</h5>
                    if (Model.IsPaid)
                    {
                        <p>Your payment has been received. The order is pending and will be processed shortly.</p>
                    }
                    else
                    {
                        <p>Your order has been placed and is awaiting payment.</p>
                    }

                    break;

                case Dto.Enums.OrderStatusEnum.Processing:

                    <h5><i class="fas fa-search"></i> Status: Processing Order</h5>
                    <p>Your order is currently being processed. We are preparing your items for shipment.</p>

                    break;

                case Dto.Enums.OrderStatusEnum.Completed:

                    <h5><i class="fas fa-search"></i> Status: Order Completed</h5>
                    if (Model.DeliveryStatus == Dto.Enums.DeliveryStatusEnum.Completed)
                    {
                        <p>Your order has been successfully completed. Thank you for shopping with us!</p>
                    }
                    else
                    {
                        <p>Your order has been completed and is ready for pickup/delivery.</p>
                    }

                    break;

                case Dto.Enums.OrderStatusEnum.Cancelled:

                    <h5><i class="fas fa-search"></i> Status: Order Cancelled</h5>
                    <p>Your order has been cancelled. No further processing will take place.</p>

                    break;

                case Dto.Enums.OrderStatusEnum.Refunded:

                    <h5><i class="fas fa-search"></i> Status: Order Refunded</h5>
                    <p>Your order has been refunded successfully. The refunded amount will be credited back to your original payment method.</p>

                    break;
                default:
                    <h5><i class="fas fa-search"></i> Status: Unknown</h5>
                    <p>The status of your order is currently unavailable. Please contact support for assistance.</p>

                    break;
            }
        </div>


        <div class="invoice p-3 mb-3" id="print-data">
            <div class="row">
                <div class="col-12">
                    <h4>
                        <img src="~/Content/website_img/logo.jpg" style="height: 50px;" /> @sysInfo.LongName
                        <small class="float-right">Date: @Model.DateCreated.ToString("MMM d, yyyy")</small>
                    </h4>
                </div>
            </div>

            <div class="row invoice-info">
                <div class="col-sm-4 invoice-col">
                    From
                    <address>
                        <strong>@sysInfo.LongName</strong><br>
                        @sysInfo.Address1<br>
                        @sysInfo.Address2<br>
                        Phone: @sysInfo.ContactNumber1<br>
                        Email: @sysInfo.ContactEmail1
                    </address>
                </div>

                <div class="col-sm-4 invoice-col">
                    To
                    <address>
                        <strong>@Model.CustomerName</strong><br>
                        @Model.Address1<br>
                        @Model.Address2<br>
                        Phone: @Model.ContactNumber<br>
                        Email: @Model.ContactEmail
                    </address>
                </div>

                <div class="col-sm-4 invoice-col">
                    <b>Invoice #@Model.InvoiceNumber</b><br>
                    <br>
                    <b>Order ID:</b> @Model.OrderNumber<br>
                    <b>Payment Due:</b> 2/22/2014<br>
                    <b>Account:</b> 968-34567
                </div>
            </div>

            <div class="row">
                <div class="col-12 table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Qty</th>
                                <th>Product</th>
                                <th>Description</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Quantity.ToString("n0")</td>
                                        <td>@item.ProductName</td>
                                        <td>@item.Description</td>
                                        <td class="text-right">@Model.Currency @item.Total.ToString("n2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row">

                <div class="col-6 row">
                    <div class="col-sm-6">
                        <p class="lead">Payment Methods:</p>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.PaymentMethod == Dto.Enums.PaymentMethodEnum.Cash ? "checked" : "") />
                            <label>Store Payment</label>
                        </div>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.PaymentMethod == Dto.Enums.PaymentMethodEnum.CreditCard ? "checked" : "") />
                            <label>Card Payment</label>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <p class="lead">Delivery Methods:</p>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.DeliveryMethod == Dto.Enums.DeliveryMethodEnum.StorePickup ? "checked" : "") />
                            <label>Store Pickup</label>
                        </div>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.DeliveryMethod == Dto.Enums.DeliveryMethodEnum.LBC ? "checked" : "") />
                            <label>Ship via LBC</label>
                        </div>
                        <div class="icheck-primary">
                            <input type="checkbox" onclick="return false;" @(Model.DeliveryMethod == Dto.Enums.DeliveryMethodEnum.BookYourOwn ? "checked" : "") />
                            <label>Book your own Rider</label>
                        </div>
                    </div>

                    <div class="col-sm-12">
                        <h5>Thanks for your order!</h5>
                        <p>We’ve received it and are getting everything ready for you. Stay tuned for updates!</p>
                    </div>

                </div>

                <div class="col-6">
                    <p class="lead">&nbsp;</p>
                    <div class="table-responsive">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <th style="width:50%">Subtotal:</th>
                                    <td class="text-right">@Model.Currency @Model.SubTotal.ToString("n2")</td>
                                </tr>
                                <tr>
                                    <th>Tax (9.3%)</th>
                                    <td class="text-right">@Model.Currency @Model.Tax.ToString("n2")</td>
                                </tr>
                                <tr>
                                    <th>Shipping:</th>
                                    <td class="text-right">@Model.Currency @Model.Shipping.ToString("n2")</td>
                                </tr>
                                <tr>
                                    <th>Total:</th>
                                    <td class="text-right">@Model.Currency @Model.Total.ToString("n2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="row no-print">
                <div class="col-12">
                    <a href="invoice-print.html" rel="noopener" target="_blank" class="btn btn-default"><i class="fas fa-print"></i> Print</a>


                    @switch (Model.Status)
                    {
                        case Dto.Enums.OrderStatusEnum.Pending:

                            if (Model.PaymentMethod == Dto.Enums.PaymentMethodEnum.Cash && !Model.IsPaid)
                            {
                                <a href="@Url.Action("TaggedAsPaid", "OrderManagement", new {area = "portal", id = Model.Id })" class="btn btn-success float-right">Receive Payment</a>
                            }
                            break;

                        case Dto.Enums.OrderStatusEnum.Processing:

                            if (!(Model.DeliveryStatus == Dto.Enums.DeliveryStatusEnum.Completed))
                            {
                                <a href="@Url.Action("OrderCompleted", "OrderManagement", new {area = "portal", id = Model.Id })" class="btn btn-success float-right">Order Completed, Ready for Pickup/Delivery</a>
                            }
                            break;

                        case Dto.Enums.OrderStatusEnum.Completed:

                            if (!(Model.DeliveryStatus == Dto.Enums.DeliveryStatusEnum.Completed))
                            {
                                <a href="@Url.Action("Delivered", "OrderManagement", new {area = "portal", id = Model.Id })" class="btn btn-success float-right">Delivery Completed</a>
                            }
                            break;
                    }

                </div>
            </div>
        </div>
    </div>
</div>