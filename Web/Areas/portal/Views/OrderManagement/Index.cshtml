
@model IEnumerable<Dto.Dto.OrderDto>

@{
    ViewBag.Title = "Orders";
}

<style>
    .dataTables_wrapper {
        width: 100%;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header pt-4 pb-4">
                <h3 class="card-title">
                    List of Orders
                </h3>
            </div>
            <div class="card-body">
                <table id="data-table" class="table table-sm table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Order Number</th>
                            <th>Date of Order</th>
                            <th>Customer Name</th>
                            <th>Currency</th>
                            <th>Total</th>
                            <th>Payment Method</th>
                            <th>Status</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.OrderNumber</td>
                                    <td>@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                    <td>@item.CustomerName</td>
                                    <td class="text-right">@item.Currency</td>
                                    <td class="text-right">@item.Total.ToString("n2")</td>
                                    <td>@item.PaymentMethod.ToString()</td>
                                    <td>@item.Status.ToString()</td>
                                    <td style="text-align: center;">
                                        <a href="@Url.Action("Details", "OrderManagement", new {area = "portal", id = item.Id})" class="btn btn-sm btn-primary" title="Update Details"><i class="fa fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div><!-- /.card-body -->
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            var accountTable = $('#data-table').DataTable({
                "processing": true,
                //"serverSide": true,
                "stateSave": true,
                "searching": true,
                //"bLengthChange": false,
                "responsive": true,
                "autoWidth": true,
                "paging": true,
                buttons: [],
                "lengthMenu": [[10, 20, 50, -1], [10, 20, 50, 'All']]
            });

        });
    </script>
}