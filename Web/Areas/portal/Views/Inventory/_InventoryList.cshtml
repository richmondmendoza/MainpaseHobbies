
@model IEnumerable<Dto.Dto.InventoryDetailsDto>

<table id="data-table" class="table table-sm table-bordered w-100">
    <thead>
        <tr>
            <th>Name</th>
            <th>Card #</th>
            <th>Set Code</th>
            <th>Set Name</th>
            <th>Foil Type</th>
            <th>Currency</th>
            <th>Price</th>
            <th>Available</th>
            <th>Owner</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Collector</td>
                <td>@item.SetCode</td>
                <td>@item.SetName</td>
                <td>@item.FoilType</td>
                <td>@item.PurchaseCurrency</td>
                <td>@item.Price</td>
                <td>@item.Count</td>
                <td>@item.OwnerName</td>
                <td><a href="@Url.Action("update", "Inventory", new { id = item.Id })" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i> Edit</a></td>
            </tr>
        }
    </tbody>
</table>
