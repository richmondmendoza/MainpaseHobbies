
@model Web.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<div class="row">
    <div class="col-md-6">

        @using (Html.BeginForm("ChangePassword", "MyAccount", FormMethod.Post, new { area = "customer", enctype = "multipart/form-data" }))
        {
            <div class="card">
                <div class="card-header pt-4 pb-4">
                    <h3 class="card-title">Change Password</h3>
                </div>

                <div class="card-body mb-0 row" id="row-with-image">

                    <div class="col-md-12">

                        <div class="form-group row">
                            <label class="col-lg-3 col-md-5 col-sm-12 col-form-label">Current Password</label>
                            <div class="col-lg-9 col-md-7 col-sm-12">
                                <div class="input-group mb-3">
                                    @Html.PasswordFor(a => a.CurrentPassword, new { @class = "form-control border-right-0", autocomplete = "off" })
                                    <div class="input-group-append border-left-0">
                                        <span class="input-group-text bg-transparent text-muted showPass" for="CurrentPassword"><i class="fas fa-eye"></i></span>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(a => a.CurrentPassword)
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-3 col-md-5 col-sm-12 col-form-label">New Password</label>
                            <div class="col-lg-9 col-md-7 col-sm-12">
                                <div class="input-group mb-3">
                                    @Html.PasswordFor(a => a.NewPassword, new { @class = "form-control border-right-0", autocomplete = "off" })
                                    <div class="input-group-append border-left-0">
                                        <span class="input-group-text bg-transparent text-muted showPass" for="NewPassword"><i class="fas fa-eye"></i></span>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(a => a.NewPassword)
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-3 col-md-5 col-sm-12 col-form-label">Confirm New Password</label>
                            <div class="col-lg-9 col-md-7 col-sm-12">
                                <div class="input-group mb-3">
                                    @Html.PasswordFor(a => a.ConfirmNewPassword, new { @class = "form-control border-right-0", autocomplete = "off" })
                                    <div class="input-group-append border-left-0">
                                        <span class="input-group-text bg-transparent text-muted showPass" for="ConfirmNewPassword"><i class="fas fa-eye"></i></span>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(a => a.ConfirmNewPassword)
                            </div>
                        </div>

                    </div>

                </div>

                <div class="card-footer text-right">
                    <a href="@Url.Action("GoBack", "Base", new {area = "", ReturnUrl = Url.Action("Index", "MyOrders", new {area = "customer"})})" class="btn btn-default mr-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">Change Password</button>
                </div>

            </div>
        }
    </div>
</div>

@section scripts{
    <script>

        $(document).on('click', '.showPass', function (e) {
            var id = '#' + $(this).attr('for');

            var type = $(id).attr('type');

            if (type == 'text') {
                $(id).attr('type', 'password');
                $(this).html('<i class="fas fa-eye"></i>');
            } else {
                $(id).attr('type', 'text');
                $(this).html('<i class="fas fa-eye-slash"></i>');
            }

        });

        //document.getElementById("togglePassword").addEventListener("click", function () {
        //    const field = document.getElementById("passwordField");
        //    const isPassword = field.type === "password";
        //    field.type = isPassword ? "text" : "password";
        //    this.textContent = isPassword ? "Hide" : "Show";
        //});
    </script>
}